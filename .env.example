APP_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=1
FLASK_DEBUG=0
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=food_donation_platform

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
SMS_WEBHOOK_URL=

# Optional map API
GOOGLE_MAPS_API_KEY=

# Optional worker tuning
WEB_CONCURRENCY=1
LOG_LEVEL=info
